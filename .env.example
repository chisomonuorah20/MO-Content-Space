# Optional — cloud backup & sync (Supabase). Leave blank to run local-only on each device.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — on-demand voice transcription (OpenAI-compatible /audio/transcriptions API).
# Server-side only. Without it, the Transcribe button explains that transcription isn't configured.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
